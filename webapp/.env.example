# Copy to `.env` and fill in. NEVER commit the real .env.

# Admin login for the web panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Random secret used to sign the session cookie (any long random string).
SESSION_SECRET=change-me-to-a-long-random-string

# Fernet key to encrypt bot tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP — losing it makes all stored tokens unreadable.
BOT_TOKEN_KEK=

# Public HTTPS base URL where Telegram will POST webhooks (no trailing slash).
# e.g. https://bots.example.com   (for local dev use an ngrok/cloudflare tunnel URL)
PUBLIC_URL=

# SQLite by default; swap to postgresql://... later without code changes.
DATABASE_URL=sqlite:///./data/app.db

# "dev" or "prod" (prod enables Secure cookies behind TLS).
ENVIRONMENT=dev

# Send rate limits (safety margin under Telegram's ~30/s + 20/min per group).
# Lower = safer but slower under peak; higher = faster but closer to limits.
RATE_OVERALL_PER_SEC=25
RATE_GROUP_INTERVAL_SEC=3.5
